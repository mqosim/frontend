{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/shared/infrastructure/api/schema.ts",
    "api:refresh": "bun scripts/refresh-openapi.mjs"
  },
  "dependencies": {
    "@vee-validate/zod": "^4.15.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.19.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.7"
  }
}
