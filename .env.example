# Copy to `.env.local` and adjust. Never commit real values.

# Base URL of the backend API. Leave EMPTY for local development: the dev server
# proxies `/api` to the backend (see vite.config.ts) and every generated API
# path already starts with `/api/v1`, so no base is needed here.
#
# Set it only to target another ORIGIN directly (bypassing the proxy), e.g.
#   https://api.example.com
# Do NOT include a path or the `/api/v1` suffix — that would double the prefix
# and produce requests like `/api/v1/api/v1/...`.
VITE_API_BASE_URL=

# E-IMZO mock. BOTH must hold for the mock to load: this build must be a dev
# build (import.meta.env.DEV) AND VITE_EIMZO_MOCK must be exactly "true".
# The mock is compiled out of production bundles entirely. The mock signs a
# server challenge through the backend's dev-only endpoint
# (POST /api/v1/identity/eimzo/mock/sign), which the backend accepts only when
# it is started with EIMZO_MODE=mock (APP_ENV dev/test). The two presets map to
# the two fixed keys the mock reports:
#   personal_mock -> authenticates a PERSON
#   org_mock      -> authenticates an ORG
VITE_EIMZO_MOCK=false

# Inactivity (idle) timeout in milliseconds. All optional: leave empty to use
# the product defaults (regular/PERSON+ORG 20 min, SYSTEM 10 min, and a 60 s
# warning countdown). Mainly useful for shortening the timeout during QA.
VITE_IDLE_WARN_MS_REGULAR=
VITE_IDLE_WARN_MS_SYSTEM=
VITE_IDLE_COUNTDOWN_MS=
