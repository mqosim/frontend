# Dependencies and build output are recreated inside the image.
node_modules
dist

# Version control and editor state
.git
.vscode
.idea

# Local env files must never enter the build context or image layers.
.env
.env.*
*.local

# Not needed to build the SPA
docs
openapi
scripts
README.md
logs
*.log

# Docker files themselves
Dockerfile
.dockerignore
